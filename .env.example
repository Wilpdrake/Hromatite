# === General ===
ENABLED_MODULES=bot,web,vpn
DATABASE_URL=sqlite+aiosqlite:///bot.db

# === Bot Module ===
BOT_TOKEN=
ADMIN_ID=0
PRICE_PER_DEVICE=100
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_ASSET=

# === VPN Server ===
VPN_SERVER_HOST=
VPN_SERVER_USER=
VPN_SERVER_PASSWORD=
VPN_SERVER_PORT=22
XRAY_PORT=443
AWG_PORT=55424
XRAY_REALITY_SERVER_NAME=www.googletagmanager.com
XRAY_CONTAINER=hromatite-xray
AWG_CONTAINER=hromatite-awg
USE_SUDO=true

# === Web Module (FastAPI local admin) ===
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ADMIN_TOKEN=change-me

# === Remote Gateway Autodeploy ===
# Used by scripts/deploy_remote_gateway.py
# Scheme: Cloudflare -> remote nginx:80/443 -> WireGuard -> local FastAPI:8000

DEPLOY_DOMAIN=wilpdrake.ru
DEPLOY_FASTAPI_PORT=8000
DEPLOY_INSTALL_PACKAGES=true
DEPLOY_RELOAD_SERVICES=true

# Optional SSH key path. If empty, VPN_SERVER_PASSWORD will be used.
VPN_SERVER_SSH_KEY=

# WireGuard remote server settings
WG_PORT=51820
WG_SERVER_ADDRESS=10.66.66.1/24
WG_CLIENT_ADDRESS=10.66.66.2

# Secrets. Fill only in local .env, do not commit real values.
WG_SERVER_PRIVATE_KEY=
WG_CLIENT_PUBLIC_KEY=